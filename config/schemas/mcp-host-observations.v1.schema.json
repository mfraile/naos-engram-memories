{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/naos-engram/mcp-host-observations.v1.schema.json",
  "title": "NAOS Engram MCP real-host observation register",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "register_version", "claim_rule", "observations"],
  "properties": {
    "$schema": {"const": "schemas/mcp-host-observations.v1.schema.json"},
    "schema_version": {"const": 1},
    "register_version": {"type": "string", "minLength": 1},
    "claim_rule": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "nullableGitObjectId": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        {"type": "null"}
      ]
    },
    "nullableVersion": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "nullableNonEmptyString": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "checkStatus": {
      "enum": ["passed", "failed", "not_performed", "not_run", "not_retained"]
    },
    "hostLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name", "version", "sha256"],
      "properties": {
        "role": {"enum": ["outer_application", "ide_extension", "embedded_engine", "standalone_engine"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "lifecycleProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "observed_count"],
      "properties": {
        "status": {"enum": ["passed", "failed", "not_run", "not_retained"]},
        "method": {"type": "string", "minLength": 1},
        "observed_count": {"type": ["integer", "null"], "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "passed"}}},
          "then": {"properties": {"observed_count": {"const": 0}}}
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {"properties": {"observed_count": {"type": "integer", "minimum": 1}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["not_run", "not_retained"]}}},
          "then": {"properties": {"observed_count": {"type": "null"}}}
        }
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_path", "sha256"],
      "properties": {
        "repository_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]",
          "not": {"pattern": "(^|/)\\.\\.(/|$)"}
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host_id",
        "execution_mode",
        "recorded_at",
        "executed_at",
        "platform",
        "host_layers",
        "provider",
        "toolkit",
        "project_resolution",
        "checks",
        "clean_quit",
        "runtime_support_claim",
        "disposition",
        "limitations",
        "source_refs"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "host_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "execution_mode": {"enum": ["standalone_cli", "desktop_app_embedded_engine", "ide_extension_embedded_engine"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "executed_at": {"type": ["string", "null"], "format": "date-time"},
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "os_version", "os_build", "architecture"],
          "properties": {
            "os": {"enum": ["macos", "ubuntu", "windows", "unknown"]},
            "os_version": {"$ref": "#/$defs/nullableVersion"},
            "os_build": {"$ref": "#/$defs/nullableVersion"},
            "architecture": {"enum": ["arm64", "x86_64", "unknown"]}
          }
        },
        "host_layers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hostLayer"}
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"$ref": "#/$defs/nullableVersion"},
            "sha256": {"$ref": "#/$defs/nullableSha256"}
          }
        },
        "toolkit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "source_commit_context", "source_tree_context", "installed_wrapper_sha256"],
          "properties": {
            "version": {"$ref": "#/$defs/nullableVersion"},
            "source_commit_context": {"$ref": "#/$defs/nullableGitObjectId"},
            "source_tree_context": {"$ref": "#/$defs/nullableGitObjectId"},
            "installed_wrapper_sha256": {"$ref": "#/$defs/nullableSha256"}
          }
        },
        "project_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_project",
            "returned_project",
            "provider_source",
            "project_path_state",
            "incoming_project_signal",
            "workspace_signal",
            "wrapper_resolution_source",
            "workspace_kind"
          ],
          "properties": {
            "expected_project": {"$ref": "#/$defs/nullableNonEmptyString"},
            "returned_project": {"$ref": "#/$defs/nullableNonEmptyString"},
            "provider_source": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "project_path_state": {"enum": ["empty", "nonempty", "not_retained"]},
            "incoming_project_signal": {"enum": ["present", "absent", "not_retained"]},
            "workspace_signal": {"enum": ["claude_project_dir", "process_cwd", "not_retained"]},
            "wrapper_resolution_source": {"enum": ["approved_git_remote", "registered_explicit_project", "not_retained"]},
            "workspace_kind": {"enum": ["synthetic_git_repository", "generated_git_worktree", "registered_git_repository", "not_retained"]}
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host_connected_mcp_server",
            "mem_current_project",
            "registered_canonical_project",
            "workspace_signal_provenance",
            "wrapper_resolution_provenance",
            "memory_read",
            "memory_save",
            "unregistered_project",
            "remote_mismatch",
            "provider_unavailable",
            "several_projects_isolated",
            "clean_profile_isolation",
            "credential_isolation",
            "restart_persistence"
          ],
          "properties": {
            "host_connected_mcp_server": {"$ref": "#/$defs/checkStatus"},
            "mem_current_project": {"$ref": "#/$defs/checkStatus"},
            "registered_canonical_project": {"$ref": "#/$defs/checkStatus"},
            "workspace_signal_provenance": {"$ref": "#/$defs/checkStatus"},
            "wrapper_resolution_provenance": {"$ref": "#/$defs/checkStatus"},
            "memory_read": {"$ref": "#/$defs/checkStatus"},
            "memory_save": {"$ref": "#/$defs/checkStatus"},
            "unregistered_project": {"$ref": "#/$defs/checkStatus"},
            "remote_mismatch": {"$ref": "#/$defs/checkStatus"},
            "provider_unavailable": {"$ref": "#/$defs/checkStatus"},
            "several_projects_isolated": {"$ref": "#/$defs/checkStatus"},
            "clean_profile_isolation": {"$ref": "#/$defs/checkStatus"},
            "credential_isolation": {"$ref": "#/$defs/checkStatus"},
            "restart_persistence": {"$ref": "#/$defs/checkStatus"}
          }
        },
        "clean_quit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime_processes", "database_holders", "client_leases"],
          "properties": {
            "runtime_processes": {"$ref": "#/$defs/lifecycleProbe"},
            "database_holders": {"$ref": "#/$defs/lifecycleProbe"},
            "client_leases": {"$ref": "#/$defs/lifecycleProbe"}
          }
        },
        "runtime_support_claim": {"const": false},
        "disposition": {"const": "partial_real_host_evidence_not_promoted"},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "source_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceRef"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"execution_mode": {"const": "standalone_cli"}}},
          "then": {
            "properties": {
              "host_layers": {
                "maxItems": 1,
                "contains": {
                  "type": "object",
                  "required": ["role"],
                  "properties": {"role": {"const": "standalone_engine"}}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"execution_mode": {"const": "desktop_app_embedded_engine"}}},
          "then": {
            "properties": {
              "host_layers": {
                "minItems": 2,
                "maxItems": 2,
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": ["role"],
                      "properties": {"role": {"const": "outer_application"}}
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "required": ["role"],
                      "properties": {"role": {"const": "embedded_engine"}}
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"execution_mode": {"const": "ide_extension_embedded_engine"}}},
          "then": {
            "properties": {
              "host_layers": {
                "minItems": 3,
                "maxItems": 3,
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": ["role"],
                      "properties": {"role": {"const": "outer_application"}}
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "required": ["role"],
                      "properties": {"role": {"const": "ide_extension"}}
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "required": ["role"],
                      "properties": {"role": {"const": "embedded_engine"}}
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checks": {
                "properties": {
                  "mem_current_project": {
                    "enum": ["failed", "not_performed", "not_run", "not_retained"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "project_resolution": {
                "properties": {"returned_project": {"type": "null"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checks": {
                "properties": {"registered_canonical_project": {"const": "passed"}}
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "properties": {"mem_current_project": {"const": "passed"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checks": {
                "properties": {"mem_current_project": {"const": "passed"}}
              }
            }
          },
          "then": {
            "properties": {
              "project_resolution": {
                "properties": {
                  "expected_project": {"type": "string", "minLength": 1},
                  "returned_project": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checks": {
                "properties": {"workspace_signal_provenance": {"const": "passed"}}
              }
            }
          },
          "then": {
            "properties": {
              "project_resolution": {
                "properties": {"workspace_signal": {"not": {"const": "not_retained"}}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checks": {
                "properties": {"wrapper_resolution_provenance": {"const": "passed"}}
              }
            }
          },
          "then": {
            "properties": {
              "project_resolution": {
                "properties": {"wrapper_resolution_source": {"not": {"const": "not_retained"}}}
              }
            }
          }
        }
      ]
    }
  }
}
